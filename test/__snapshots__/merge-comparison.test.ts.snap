    "defaults": {
      "a": 1,
      "b": 1,
      "c": 1,
    },
    "override": {
      "c": 3,
    },
    "user": {
      "b": 2,
      "c": 2,
    },
  },
  "resultConfigMerge": {
    "a": 1,
    "b": 1,
    "c": 1,
  },
  "resultDeepMerge": {
    "a": 1,
    "b": 2,
    "c": 3,
  },
  "resultDeepMerge3": {
    "a": 1,
    "b": 2,
    "c": 3,
  },
  "tags": "precedence, left-to-right, priority",
}
`;

